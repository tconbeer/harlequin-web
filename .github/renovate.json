{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "prCreation": "immediate",
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Wait three days before proposing a new npm release, so a compromised or yanked one is caught first.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group non-major updates into a single PR and merge on green CI.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-nonmajor",
      "automerge": true
    },
    {
      "description": "Majors get one PR each, but still merge themselves once CI is green.",
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "Each of these pins the Vite major the others run on, so their majors land together.",
      "matchPackageNames": [
        "vite",
        "vitest",
        "@vitest/**",
        "@sveltejs/vite-plugin-svelte"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "vite major",
      "groupSlug": "vite-major"
    },
    {
      "description": "SvelteKit majors need code migrated by hand, and the Vercel adapter's major follows Kit's.",
      "matchPackageNames": ["@sveltejs/kit", "@sveltejs/adapter-vercel"],
      "matchUpdateTypes": ["major"],
      "groupName": "sveltekit major",
      "groupSlug": "sveltekit-major",
      "automerge": false
    },
    {
      "description": "Raise the engines.node patch floor with each Node patch, so it tracks .nvmrc.",
      "matchDepTypes": ["engines"],
      "matchDepNames": ["node"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep Node on even-numbered (LTS) lines only.",
      "matchDepNames": ["node"],
      "allowedVersions": "/^v?\\d*[02468]\\./"
    },
    {
      "description": "A Node major also means changing the adapter runtime in svelte.config.js, so it is one PR merged by hand.",
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node major",
      "groupSlug": "node-major",
      "automerge": false
    }
  ]
}
