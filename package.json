{
  "name": "harlequin-web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write --plugin prettier-plugin-svelte --plugin prettier-plugin-organize-imports --plugin prettier-plugin-tailwindcss .",
    "themes": "svgo -f ./src/lib/assets/themes -o ./src/lib/assets/themes",
    "test:e2e": "playwright test"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "devDependencies": {
    "@fastify/pre-commit": "^2.2.2",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-svelte": "^2.46.1",
    "mdsvex": "^0.11.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-slug": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^3.8.6",
    "svgo": "^3.3.5",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
